{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsusync.invalid/contracts/vfx-files/v1/event-batch.schema.json",
  "title": "Plugin event batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "events"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "events": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"oneOf": [{"$ref": "file-event.schema.json"}, {"$ref": "folder-event.schema.json"}, {"$ref": "output-package-event.schema.json"}]}}
  }
}
