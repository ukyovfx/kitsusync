{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsusync.invalid/contracts/vfx-files/v1/event-batch.schema.json",
  "title": "Plugin event batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "events"],
  "properties": {
    "contract_version": {"enum": ["1.0", "1.1"]},
    "events": {"type": "array", "minItems": 1, "maxItems": 100}
  },
  "allOf": [
    {
      "if": {"properties": {"contract_version": {"const": "1.0"}}, "required": ["contract_version"]},
      "then": {"properties": {"events": {"items": {"oneOf": [
        {"$ref": "file-event.schema.json"},
        {"$ref": "folder-event.schema.json"},
        {"$ref": "output-package-event.schema.json"},
        {"$ref": "authority-transition-event.schema.json"}
      ]}}}}
    },
    {
      "if": {"properties": {"contract_version": {"const": "1.1"}}, "required": ["contract_version"]},
      "then": {"properties": {"events": {"items": {"$ref": "file-share-created-v1.1.schema.json"}}}}
    }
  ]
}
