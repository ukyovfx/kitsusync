{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsusync.invalid/contracts/vfx-files/v1/output-package-event.schema.json",
  "title": "Output Package lifecycle event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "producer_id",
    "event_id",
    "event_type",
    "occurred_at",
    "production_id",
    "activation_epoch",
    "source",
    "output_package"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "producer_id": {
      "const": "vfx-files-plugin"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "output_package.created",
        "output_package.ready"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "production_id": {
      "type": "string",
      "format": "uuid"
    },
    "activation_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_type_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_type_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_type_name": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "sender_person_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "output_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "classification",
        "manifest_sha256",
        "objects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "classification": {
          "type": "string",
          "maxLength": 100
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "pattern": "^manifest:[0-9a-fA-F-]{36}$"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "drive_file_id",
              "classification",
              "size_bytes",
              "sha256"
            ],
            "properties": {
              "drive_file_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_-]{1,200}$"
              },
              "classification": {
                "type": "string",
                "maxLength": 100
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "frame_range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/frameRange"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "step",
        "rate_num",
        "rate_den"
      ],
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "rate_num": {
          "type": "integer",
          "minimum": 1
        },
        "rate_den": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
