{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsusync.invalid/contracts/vfx-files/v1/sync-preview.schema.json",
  "title": "Read-only sync preview result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "preview_id", "production_id", "config_revision", "root_id", "state", "summary", "expires_at"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "preview_id": {"type": "string", "format": "uuid"},
    "production_id": {"type": "string", "format": "uuid"},
    "config_revision": {"type": "integer", "minimum": 1},
    "root_id": {"type": "string", "minLength": 1},
    "state": {"const": "preview_ready"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existing", "create", "link", "excluded", "warnings"],
      "properties": {
        "existing": {"type": "integer", "minimum": 0},
        "create": {"type": "integer", "minimum": 0},
        "link": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      }
    },
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}, "maxItems": 500},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "object_type", "object_id", "display_name", "reason"],
      "properties": {
        "action": {"enum": ["existing", "create", "link", "exclude", "warning"]},
        "object_type": {"enum": ["production", "episode", "sequence", "shot", "asset", "task"]},
        "object_id": {"type": "string", "format": "uuid"},
        "display_name": {"type": "string", "maxLength": 240},
        "parent_id": {"type": ["string", "null"], "format": "uuid"},
        "reason": {"type": "string", "maxLength": 500}
      }
    }
  }
}
