#!/bin/bash
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

for inherited_name in $(compgen -e); do
  case "${inherited_name}" in DOCKER_*|COMPOSE_*) printf 'ERROR: inherited Docker/Compose control variables are not accepted\n' >&2; exit 1 ;; esac
done

CONTROL_DIR=/etc/kitsusync-deploy
STATE_DIR=/var/lib/kitsusync-deploy
BACKUP_ROOT=/var/backups/kitsusync-deploy
RUNTIME_ROOT=/home/ukyo_vfx/kitsusync
COMPOSE_FILE=${CONTROL_DIR}/docker-compose.yml
ENV_FILE=${CONTROL_DIR}/.env.local
PROVENANCE_FILE=${CONTROL_DIR}/provenance
MODE_FILE=${CONTROL_DIR}/deployment-mode
LEGACY_IMAGE_FILE=${CONTROL_DIR}/legacy-image.id
FRESH_PENDING_FILE=${STATE_DIR}/fresh-install.pending
FRESH_SEED_MARKER=${RUNTIME_ROOT}/.fresh-install-seed
IMAGE_ARCHIVE=${STATE_DIR}/kitsusync-image.tar
SQLITE_BACKUP=/usr/local/libexec/kitsusync-sqlite-backup
IMAGE_IDENTITY=/usr/local/libexec/kitsusync-image-identity
RUNTIME_STATE=/usr/local/libexec/kitsusync-runtime-state
RESTORE_STATE=/usr/local/libexec/kitsusync-restore-state
PROJECT_NAME=kitsusync
SERVICE=app
EXPECTED_CONTAINER_NAME=/kitsusync-app-1

die() { printf 'ERROR: %s\n' "$*" >&2; /usr/bin/logger -t kitsusync-deploy -- "failed: $*" 2>/dev/null || true; exit 1; }
log() { /usr/bin/logger -t kitsusync-deploy -- "$*" 2>/dev/null || true; }

readiness_allows() {
  local mode="$1" readiness="$2"
  case "${mode}:${readiness}" in
    normal:ready|legacy-migration:ready|recovery:ready|recovery:setup_required|fresh-install:setup_required|preview:ready|preview:setup_required) return 0 ;;
    *) return 1 ;;
  esac
}

legacy_status_allows() {
  [[ "$1" == "$2" && "$3" == 200 && "$4" == 404 ]]
}

restored_validation_mode() {
  # A restored prior runtime may safely resume in setup_required when its
  # external credentials are unavailable. It must still pass every other
  # runtime identity, health, endpoint, and admin-boundary check.
  [[ "$1" == legacy ]] && printf 'legacy\n' || printf 'recovery\n'
}

archive_image_id_allows() {
  [[ "$1" == "$2" || "$1" == "$3" ]]
}

backup_is_complete() {
  [[ -f "$1/backup-complete" && -s "$1/sqlite.db" && -f "$1/persistent-state.sha256" ]] || return 1
  /usr/bin/sha256sum -c "$1/persistent-state.sha256" >/dev/null 2>&1
}

snapshot_runtime_state() {
  local id="$1" target="$2" container_name short_id
  /usr/bin/install -d -m 0700 "${target}"
  container_name="$(${DOCKER_BIN} inspect --format '{{.Name}}' "${id}")"; container_name="${container_name#/}"
  short_id="${id:0:12}"
  # Docker API versions may omit zero-valued optional Config keys. Normalize
  # those keys without dropping any runtime-significant field from comparison.
  ${DOCKER_BIN} inspect --format '{{json .Config}}' "${id}" | /usr/bin/python3 -c '
import json
import sys

config = json.load(sys.stdin)
required = ("Hostname", "User", "WorkingDir", "Domainname", "Tty", "OpenStdin", "StdinOnce")
missing = [key for key in required if key not in config]
if missing:
    raise SystemExit("required container config fields are missing: " + ",".join(missing))

def compact(value):
    return json.dumps(value, separators=(",", ":"), sort_keys=True)

def boolean(value):
    return "true" if value else "false"

hostname = config["Hostname"] or ""
if hostname in (sys.argv[1], sys.argv[2]):
    hostname = ""

values = (
    ("hostname", hostname),
    ("user", config["User"] or ""),
    ("working_dir", config["WorkingDir"] or ""),
    ("domainname", config["Domainname"] or ""),
    ("tty", boolean(config["Tty"])),
    ("open_stdin", boolean(config["OpenStdin"])),
    ("stdin_once", boolean(config["StdinOnce"])),
    ("network_disabled", boolean(config.get("NetworkDisabled", False))),
    # Per-network MAC addresses are captured by the strict runtime plan. Docker
    # may rewrite this deprecated duplicate Config field during reconstruction.
    ("mac_address", ""),
    ("entrypoint", compact(config.get("Entrypoint"))),
    ("cmd", compact(config.get("Cmd"))),
    ("healthcheck", compact(config.get("Healthcheck"))),
    ("exposed_ports", compact(config.get("ExposedPorts"))),
    ("stop_signal", config.get("StopSignal") or ""),
    ("stop_timeout", compact(config.get("StopTimeout"))),
)
for key, value in values:
    print(f"{key}={value}")
' "${id}" "${short_id}" >"${target}/runtime-config"
  ${DOCKER_BIN} inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "${id}" | LC_ALL=C /usr/bin/sort >"${target}/runtime-env"
  ${DOCKER_BIN} inspect --format '{{range $key, $value := .Config.Labels}}{{printf "%s=%s\n" $key $value}}{{end}}' "${id}" \
    | /usr/bin/grep -Ev '^com\.docker\.compose\.(config-hash|project\.config_files|project\.working_dir)=' \
    | LC_ALL=C /usr/bin/sort >"${target}/runtime-labels"
  ${DOCKER_BIN} inspect --format '{{json .HostConfig}}' "${id}" | /usr/bin/python3 -c '
import json
import sys

host_config = json.load(sys.stdin)
# Docker APIs may report the unset default as either null/missing or false.
# Keep an explicitly enabled policy distinct while normalizing only that
# reconstruction-only default difference.
if host_config.get("OomKillDisable") is None:
    host_config["OomKillDisable"] = False
print(json.dumps(host_config, sort_keys=True, separators=(",", ":")))
' >"${target}/runtime-host-config" || return 1
  ${DOCKER_BIN} inspect --format '{{json .Mounts}}' "${id}" | /usr/bin/python3 -c 'import json,sys; print(json.dumps(sorted(json.load(sys.stdin),key=lambda m:m["Destination"]),sort_keys=True,separators=(",",":")))' >"${target}/runtime-mounts" || return 1
  ${DOCKER_BIN} inspect --format '{{range $name, $network := .NetworkSettings.Networks}}{{printf "%s|%s\n" $name $network.NetworkID}}{{end}}' "${id}" | LC_ALL=C /usr/bin/sort >"${target}/runtime-networks"
  : >"${target}/runtime-network-aliases"
  while IFS='|' read -r network alias; do
    [[ -n "${network}" && -n "${alias}" ]] || continue
    [[ "${alias}" == "${id}" || "${alias}" == "${short_id}" || "${alias}" == "${container_name}" ]] && continue
    printf '%s|%s\n' "${network}" "${alias}" >>"${target}/runtime-network-aliases"
  done < <(${DOCKER_BIN} inspect --format '{{range $name, $network := .NetworkSettings.Networks}}{{range $network.Aliases}}{{printf "%s|%s\n" $name .}}{{end}}{{end}}' "${id}")
  LC_ALL=C /usr/bin/sort -o "${target}/runtime-network-aliases" "${target}/runtime-network-aliases"
}

compare_runtime_state() {
  local id="$1" expected="$2" expected_image_id="$3" expected_revision="$4" expected_source="$5" expected_version="$6" actual part
  [[ "$(${DOCKER_BIN} inspect --format '{{.Image}}' "${id}")" == "${expected_image_id}" ]] || return 1
  [[ "$(${DOCKER_BIN} inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "${id}")" == "${expected_revision}" ]] || return 1
  [[ "$(${DOCKER_BIN} inspect --format '{{index .Config.Labels "org.opencontainers.image.source-id"}}' "${id}")" == "${expected_source}" ]] || return 1
  [[ "$(${DOCKER_BIN} inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "${id}")" == "${expected_version}" ]] || return 1
  actual="$(/usr/bin/mktemp -d)"
  snapshot_runtime_state "${id}" "${actual}" || { /usr/bin/rm -rf "${actual}"; return 1; }
  for part in runtime-config runtime-env runtime-labels runtime-host-config runtime-mounts runtime-networks runtime-network-aliases; do
    /usr/bin/cmp -s "${actual}/${part}" "${expected}/${part}" || { /usr/bin/rm -rf "${actual}"; return 1; }
  done
  /usr/bin/rm -rf "${actual}"
}

# A new container can be running before either its first healthcheck or Kitsu
# token validation completes. Apply one wall-clock budget to every probe.
STARTUP_TIMEOUT=180
STARTUP_INTERVAL=2
CURL_BIN=/usr/bin/curl
startup_command() {
  local remaining=$((VALIDATION_DEADLINE - SECONDS))
  (( remaining > 0 )) || return 1
  (( remaining <= 10 )) || remaining=10
  /usr/bin/timeout --signal=KILL "${remaining}s" "$@" 2>/dev/null
}

runtime_probe() {
  local id="$1" mode="$2" expected_revision="$3" expected_source="$4" expected_version="$5" value response code state path kitsu_probe_url
  VALIDATION_RETRY=1
  VALIDATION_STAGE=container_state
  value="$(startup_command "${DOCKER_BIN}" inspect --format '{{.State.Status}}' "${id}")" || return 1
  case "${value}" in running) ;; exited|dead|removing) VALIDATION_RETRY=0; return 1 ;; *) return 1 ;; esac
  VALIDATION_STAGE=port_binding
  value="$(startup_command "${DOCKER_BIN}" port "${id}" 8090/tcp)" || return 1
  [[ "${value}" == 127.0.0.1:8090 ]] || { VALIDATION_RETRY=0; return 1; }
  if [[ "${mode}" == legacy ]]; then
    VALIDATION_STAGE=legacy_image
    value="$(startup_command "${DOCKER_BIN}" inspect --format '{{.Image}}' "${id}")" || return 1
    [[ "${value}" == "${expected_revision}" ]] || { VALIDATION_RETRY=0; return 1; }
  else
    VALIDATION_STAGE=image_revision
    value="$(startup_command "${DOCKER_BIN}" inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "${id}")" || return 1
    [[ "${value}" == "${expected_revision}" ]] || { VALIDATION_RETRY=0; return 1; }
    VALIDATION_STAGE=image_source
    value="$(startup_command "${DOCKER_BIN}" inspect --format '{{index .Config.Labels "org.opencontainers.image.source-id"}}' "${id}")" || return 1
    [[ "${value}" == "${expected_source}" ]] || { VALIDATION_RETRY=0; return 1; }
    VALIDATION_STAGE=image_version
    value="$(startup_command "${DOCKER_BIN}" inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "${id}")" || return 1
    [[ "${value}" == "${expected_version}" ]] || { VALIDATION_RETRY=0; return 1; }
  fi
  VALIDATION_STAGE=docker_health
  value="$(startup_command "${DOCKER_BIN}" inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "${id}")" || return 1
  [[ "${value}" == healthy ]] || return 1
  if [[ "${mode}" == fresh-install ]]; then
    kitsu_probe_url="$(/usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/python3 - "${ENV_FILE}" <<'PY'
import pathlib
import sys
from urllib.parse import urlsplit, urlunsplit

values = []
for line in pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
    if line.startswith("KITSU_HOSTNAME="):
        values.append(line.split("=", 1)[1].strip())
if len(values) != 1:
    raise SystemExit("protected KITSU_HOSTNAME is unavailable or ambiguous")
if values[0]:
    parsed = urlsplit(values[0])
    if parsed.scheme not in ("http", "https") or not parsed.hostname:
        raise SystemExit("protected KITSU_HOSTNAME is invalid")
    path = parsed.path.rstrip("/") + "/api/"
    print(urlunsplit((parsed.scheme, parsed.netloc, path, "", "")))
PY
)" || { VALIDATION_RETRY=0; return 1; }
    if [[ -n "${kitsu_probe_url}" ]]; then
      VALIDATION_STAGE=kitsu_connectivity
      code="$(startup_command "${DOCKER_BIN}" exec "${id}" /usr/bin/curl --silent --output /dev/null --write-out '%{http_code}' --max-time 10 "${kitsu_probe_url}")" || return 1
      [[ "${code}" == 200 ]] || return 1
    fi
  fi
  VALIDATION_STAGE=local_health
  if [[ "${mode}" == legacy ]]; then
    code="$(startup_command "${CURL_BIN}" --silent --output /dev/null --write-out '%{http_code}' --max-time 10 http://127.0.0.1:8090/health)" || return 1
    [[ "${code}" == 200 ]] || return 1
    VALIDATION_STAGE=legacy_readiness
    code="$(startup_command "${CURL_BIN}" --silent --output /dev/null --write-out '%{http_code}' --max-time 10 http://127.0.0.1:8090/ready)" || return 1
    [[ "${code}" == 404 ]] || return 1
    return 0
  fi
  startup_command "${CURL_BIN}" --fail --silent --max-time 10 --max-filesize 65536 http://127.0.0.1:8090/health | /usr/bin/grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' || return 1
  VALIDATION_STAGE=readiness
  response="$(startup_command "${CURL_BIN}" --silent --max-time 10 --max-filesize 65536 --write-out $'\n%{http_code}' http://127.0.0.1:8090/ready)" || return 1
  code="$(printf '%s\n' "${response}" | /usr/bin/tail -n 1)"
  state="$(printf '%s\n' "${response}" | /usr/bin/sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | /usr/bin/head -n 1)"
  readiness_allows "${mode}" "${state}" || { [[ "${state}" != degraded ]] || VALIDATION_RETRY=0; return 1; }
  case "${state}:${code}" in ready:200|setup_required:503) ;; *) return 1 ;; esac
  VALIDATION_STAGE=readiness_identity
  if ! printf '%s\n' "${response}" | /usr/bin/grep -Fq "\"base_commit\":\"${expected_revision}\""; then
    printf 'readiness identity mismatch: base_commit\n' >&2; VALIDATION_RETRY=0; return 1
  fi
  if ! printf '%s\n' "${response}" | /usr/bin/grep -Fq "\"build_source_id\":\"${expected_source}\""; then
    printf 'readiness identity mismatch: build_source_id\n' >&2; VALIDATION_RETRY=0; return 1
  fi
  VALIDATION_STAGE=admin_boundary
  for path in /api/setup/status /bot/login /bot/setup /bot/admin /bot/admin/health /bot/admin/users; do
    code="$(startup_command "${CURL_BIN}" --silent --output /dev/null --write-out '%{http_code}' --max-time 10 "http://127.0.0.1:8090${path}")" || return 1
    [[ "${code}" =~ ^(200|302|303|401|403)$ ]] || return 1
  done
}

validate_runtime() {
  local VALIDATION_DEADLINE=$((SECONDS + STARTUP_TIMEOUT)) VALIDATION_STAGE=initial VALIDATION_RETRY=1 remaining pause last_failure=initial
  while (( SECONDS < VALIDATION_DEADLINE )); do
    if runtime_probe "$@"; then
      (( SECONDS < VALIDATION_DEADLINE )) && return 0
    fi
    # Report the last completed failing probe, not a later check that merely
    # ran out of the shared deadline before it could execute.
    if (( SECONDS >= VALIDATION_DEADLINE )) && [[ "${last_failure}" != initial ]]; then
      VALIDATION_STAGE=${last_failure}; break
    fi
    last_failure=${VALIDATION_STAGE}
    [[ "${VALIDATION_RETRY}" == 1 ]] || break
    remaining=$((VALIDATION_DEADLINE - SECONDS))
    (( remaining > 0 )) || break
    pause=${STARTUP_INTERVAL}; (( pause <= remaining )) || pause=${remaining}
    /usr/bin/sleep "${pause}"
  done
  printf 'runtime validation failed: check=%s\n' "${VALIDATION_STAGE}" >&2
  return 1
}

validate_legacy_runtime() {
  validate_runtime "$1" legacy "${previous_image_id}" '' ''
}

if [[ -n "${KITSUSYNC_DEPLOY_TEST_MODE:-}" ]]; then
  [[ "${EUID}" -ne 0 ]] || die "test mode is forbidden for root"
  DOCKER_BIN="${KITSUSYNC_DEPLOY_TEST_DOCKER_BIN:-$(command -v docker)}"
  [[ -x "${DOCKER_BIN}" ]] || die "test Docker executable is unavailable"
  case "${KITSUSYNC_DEPLOY_TEST_MODE}" in
    readiness) [[ "$#" -eq 2 ]]; readiness_allows "$1" "$2" ;;
    restored-readiness) [[ "$#" -eq 2 ]]; readiness_allows "$(restored_validation_mode "$1")" "$2" ;;
    legacy-contract) [[ "$#" -eq 4 ]]; legacy_status_allows "$1" "$2" "$3" "$4" ;;
    backup-contract) [[ "$#" -eq 1 ]]; backup_is_complete "$1" ;;
    snapshot) [[ "$#" -eq 2 ]]; snapshot_runtime_state "$1" "$2" ;;
    compare) [[ "$#" -eq 6 ]]; compare_runtime_state "$1" "$2" "$3" "$4" "$5" "$6" ;;
    image-id) [[ "$#" -eq 3 ]]; archive_image_id_allows "$1" "$2" "$3" ;;
    runtime|legacy-runtime)
      CURL_BIN="${KITSUSYNC_DEPLOY_TEST_CURL_BIN:?test curl required}"
      # This override is test-only: the real wrapper always reads the root-owned
      # protected environment file.  Runtime validator tests need a fixture
      # KITSU_HOSTNAME when exercising the fresh-install connectivity probe.
      if [[ -n "${KITSUSYNC_DEPLOY_TEST_ENV_FILE:-}" ]]; then
        ENV_FILE=${KITSUSYNC_DEPLOY_TEST_ENV_FILE}
      fi
      STARTUP_TIMEOUT="${KITSUSYNC_DEPLOY_TEST_TIMEOUT:-5}"
      STARTUP_INTERVAL=1
      [[ -x "${CURL_BIN}" && "${STARTUP_TIMEOUT}" =~ ^[1-9][0-9]?$ ]] || die "invalid startup test controls"
      if [[ "${KITSUSYNC_DEPLOY_TEST_MODE}" == runtime ]]; then
        [[ "$#" -eq 5 ]]; validate_runtime "$@"
      else
        [[ "$#" -eq 2 ]]; previous_image_id="$2"; validate_legacy_runtime "$1"
      fi ;;
    *) die "unknown test mode" ;;
  esac
  exit $?
fi

deployment_policy="${KITSUSYNC_DEPLOY_POLICY:-}"
expected_source_commit=""
case "${deployment_policy}" in
  release) [[ "$#" -eq 0 ]] || die "arguments are not accepted" ;;
  preview)
    [[ "$#" -eq 2 && "$1" =~ ^[0-9a-f]{40}$ && "$2" == PREVIEW ]] || die "preview confirmation or exact candidate SHA is invalid"
    expected_source_commit="${KITSUSYNC_EXPECTED_SOURCE_SHA:-}"
    [[ "${expected_source_commit}" == "$1" ]] || die "preview expected source SHA changed"
    ;;
  *) die "deployment policy is unavailable" ;;
esac
[[ "${EUID}" -eq 0 ]] || die "root execution required"
DOCKER_BIN=/usr/bin/docker
cd /
for executable in /usr/bin/docker /usr/bin/curl /usr/bin/sha256sum /usr/bin/stat /usr/bin/tar /usr/bin/python3 /usr/bin/env /usr/bin/flock /usr/bin/timeout "${SQLITE_BACKUP}" "${IMAGE_IDENTITY}" "${RUNTIME_STATE}" "${RESTORE_STATE}"; do [[ -x "${executable}" ]] || die "required deployment executable is unavailable"; done
sqlite_backup() { /usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/python3 "${SQLITE_BACKUP}" "$@"; }
runtime_state() { /usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/python3 "${RUNTIME_STATE}" "$@"; }

secure_dir() { [[ -d "$1" && ! -L "$1" && "$(/usr/bin/stat -c '%u:%g:%a' "$1")" == "0:0:$2" ]] || die "trusted directory is unsafe"; }
secure_file() { [[ -f "$1" && ! -L "$1" && "$(/usr/bin/stat -c '%u:%g:%a' "$1")" == "0:0:$2" ]] || die "trusted file is unsafe"; }
reject_env_controls() { ! /usr/bin/grep -Eq '^[[:space:]]*(export[[:space:]]+)?(DOCKER_|COMPOSE_)[A-Za-z0-9_]*[[:space:]]*=' "$1" || die "protected environment contains Docker/Compose control variables"; }
secure_dir "${CONTROL_DIR}" 700; secure_dir "${STATE_DIR}" 700; secure_dir "${BACKUP_ROOT}" 700
# Serialize the entire backup/deploy/recovery transaction, including preflight.
exec 9>"${STATE_DIR}/deploy.lock"
/usr/bin/flock -n 9 || die "another deployment transaction is active"
for file in "${COMPOSE_FILE}" "${ENV_FILE}" "${PROVENANCE_FILE}" "${MODE_FILE}" "${IMAGE_ARCHIVE}"; do secure_file "${file}" 600; done
reject_env_controls "${ENV_FILE}"
[[ -d "${RUNTIME_ROOT}" && ! -L "${RUNTIME_ROOT}" && "$(/usr/bin/stat -c '%u:%g:%a' "${RUNTIME_ROOT}")" == 0:0:755 ]] || die "runtime root is replaceable or unsafe"
[[ -d "${RUNTIME_ROOT}/data" && ! -L "${RUNTIME_ROOT}/data" && "$(/usr/bin/stat -c '%u:%g:%a' "${RUNTIME_ROOT}/data")" == 10001:10001:700 ]] || die "runtime data directory is unsafe"
for runtime_file in sqlite.db sqlite.db-wal sqlite.db-shm runtime-secret.key; do
  runtime_path="${RUNTIME_ROOT}/data/${runtime_file}"
  [[ ! -e "${runtime_path}" ]] && continue
  [[ -f "${runtime_path}" && ! -L "${runtime_path}" && "$(/usr/bin/stat -c '%u:%g:%a' "${runtime_path}")" == 10001:10001:600 ]] || die "runtime database/secret file is unsafe"
done
[[ -f "${RUNTIME_ROOT}/conf.toml" && ! -L "${RUNTIME_ROOT}/conf.toml" && "$(/usr/bin/stat -c '%u:%g:%a' "${RUNTIME_ROOT}/conf.toml")" == 0:0:644 ]] || die "runtime configuration file is unsafe"
[[ -d "${RUNTIME_ROOT}/tpl" && ! -L "${RUNTIME_ROOT}/tpl" && "$(/usr/bin/stat -c '%u:%g:%a' "${RUNTIME_ROOT}/tpl")" == 0:0:755 ]] || die "runtime template directory is unsafe"
[[ -z "$(/usr/bin/find "${RUNTIME_ROOT}/tpl" -type l -print -quit)" ]] || die "runtime template symlinks are not allowed"
[[ -z "$(/usr/bin/find "${RUNTIME_ROOT}/tpl" -perm /022 -print -quit)" ]] || die "runtime templates are writable outside root"

run_dir="$(/usr/bin/mktemp -d /run/kitsusync-deploy.XXXXXX)"; trap '/usr/bin/rm -rf "${run_dir}"' EXIT
/usr/bin/install -d -o root -g root -m 0700 "${run_dir}/trusted"
for file in docker-compose.yml .env.local provenance deployment-mode; do /usr/bin/install -o root -g root -m 0600 "${CONTROL_DIR}/${file}" "${run_dir}/trusted/${file}"; done
COMPOSE_FILE=${run_dir}/trusted/docker-compose.yml; ENV_FILE=${run_dir}/trusted/.env.local; PROVENANCE_FILE=${run_dir}/trusted/provenance; MODE_FILE=${run_dir}/trusted/deployment-mode

field() { /usr/bin/sed -n "s/^$1=//p" "${PROVENANCE_FILE}" | /usr/bin/head -n 1 | /usr/bin/tr -d '\r'; }
source_commit="$(field source_commit)"; source_id="$(field source_id)"; version="$(field version)"; image="$(field image_ref)"; build_daemon_image_id="$(field build_daemon_image_id)"; archive_sha="$(field image_archive_sha256)"; approved_config_digest="$(field image_config_digest)"; approved_manifest_digest="$(field image_manifest_digest)"; approved_content_digest="$(field image_content_digest)"; compose_sha="$(field compose_sha256)"; deploy_sha="$(field deployment_tool_sha256)"; core_sha="$(field deployment_core_sha256)"; preview_sha="$(field preview_deployment_tool_sha256)"; identity_sha="$(field image_identity_tool_sha256)"; deployment_mode="$(/usr/bin/tr -d '\r\n' <"${MODE_FILE}")"
[[ "${source_commit}" =~ ^[0-9a-f]{40}$ && "${source_id}" == "${source_commit}" && "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "${image}" =~ ^kitsusync:[a-zA-Z0-9._-]+$ && "${build_daemon_image_id}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "validated deployment identity is malformed"
if [[ "${deployment_policy}" == preview ]]; then
  [[ "${source_commit}" == "${expected_source_commit}" ]] || die "preview candidate source identity mismatch"
  deployment_mode=preview
fi
[[ "${archive_sha}" =~ ^[0-9a-f]{64}$ && "${approved_config_digest}" =~ ^sha256:[0-9a-f]{64}$ && "${approved_manifest_digest}" =~ ^sha256:[0-9a-f]{64}$ && "${approved_content_digest}" =~ ^sha256:[0-9a-f]{64}$ && "${compose_sha}" =~ ^[0-9a-f]{64}$ && "${deploy_sha}" =~ ^[0-9a-f]{64}$ && "${core_sha}" =~ ^[0-9a-f]{64}$ && "${preview_sha}" =~ ^[0-9a-f]{64}$ && "${identity_sha}" =~ ^[0-9a-f]{64}$ ]] || die "bundle provenance is incomplete"
[[ "$(/usr/bin/sha256sum "${IMAGE_ARCHIVE}" | /usr/bin/cut -d' ' -f1)" == "${archive_sha}" ]] || die "approved image archive digest mismatch"
[[ "$(/usr/bin/sha256sum "${COMPOSE_FILE}" | /usr/bin/cut -d' ' -f1)" == "${compose_sha}" ]] || die "production Compose digest mismatch"
[[ "$(/usr/bin/sha256sum /usr/local/sbin/kitsusync-deploy | /usr/bin/cut -d' ' -f1)" == "${deploy_sha}" ]] || die "installed deployment tool identity mismatch"
[[ "$(/usr/bin/sha256sum /usr/local/libexec/kitsusync-deploy-transaction | /usr/bin/cut -d' ' -f1)" == "${core_sha}" ]] || die "installed deployment transaction identity mismatch"
if [[ "${deployment_policy}" == preview ]]; then
  [[ "$(/usr/bin/sha256sum /usr/local/sbin/kitsusync-preview-deploy | /usr/bin/cut -d' ' -f1)" == "${preview_sha}" ]] || die "installed preview tool identity mismatch"
  /usr/bin/logger -t kitsusync-deploy -- "PREVIEW / NON-RELEASE source_commit=${source_commit}"
fi
[[ "$(/usr/bin/sha256sum "${IMAGE_IDENTITY}" | /usr/bin/cut -d' ' -f1)" == "${identity_sha}" ]] || die "installed image identity tool mismatch"
