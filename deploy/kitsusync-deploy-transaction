write_override "${image}"
/usr/bin/docker compose --project-name "${PROJECT_NAME}" --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" -f "${override}" config --format json >"${backup_dir}/target-compose.json"
/usr/bin/python3 - "${backup_dir}/target-compose.json" "${RUNTIME_ROOT}" "${image}" <<'PY'
import json, sys
app = json.load(open(sys.argv[1]))["services"]["app"]
root, image = sys.argv[2:]
