resolve_legacy_prior_container() {
  local compose_output compose_status candidate_id candidate_name candidate_project candidate_service candidate_running candidate_image candidate_ready runtime_check
  local -a compose_ids=() direct_ids=()
  compose_status=0
  compose_output="$(compose ps -q "${SERVICE}")" || compose_status=$?
  (( compose_status == 0 )) || die "KitsuSync Compose discovery failed"
  mapfile -t compose_ids < <(printf '%s\n' "${compose_output}" | /usr/bin/sed '/^[[:space:]]*$/d')
  if [[ "${#compose_ids[@]}" -gt 1 ]]; then
    die "duplicate retained service containers require operator preflight"
  elif [[ "${#compose_ids[@]}" -eq 1 ]]; then
    printf 'compose:%s\n' "${compose_ids[0]}"
    return 0
  fi

  mapfile -t direct_ids < <(${DOCKER_BIN} ps -q --no-trunc --filter "label=com.docker.compose.project=${PROJECT_NAME}" --filter "label=com.docker.compose.service=${SERVICE}" --filter status=running)
  [[ "${#direct_ids[@]}" -eq 1 ]] || die "legacy migration requires exactly one running prior container"
  candidate_id="${direct_ids[0]}"
  candidate_name="$(${DOCKER_BIN} inspect --format '{{.Name}}' "${candidate_id}")"
  candidate_project="$(${DOCKER_BIN} inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "${candidate_id}")"
  candidate_service="$(${DOCKER_BIN} inspect --format '{{index .Config.Labels "com.docker.compose.service"}}' "${candidate_id}")"
  candidate_running="$(${DOCKER_BIN} inspect --format '{{.State.Running}}' "${candidate_id}")"
  candidate_image="$(${DOCKER_BIN} inspect --format '{{.Image}}' "${candidate_id}")"
  [[ "${candidate_name}" == "${EXPECTED_CONTAINER_NAME}" && "${candidate_project}" == "${PROJECT_NAME}" && "${candidate_service}" == "${SERVICE}" && "${candidate_running}" == true ]] || die "legacy prior container identity is invalid"
  [[ "${candidate_image}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "legacy prior image identity is unavailable"
  candidate_ready="$("${CURL_BIN}" --silent --output /dev/null --write-out '%{http_code}' --max-time 5 http://127.0.0.1:8090/ready || true)"
  [[ "${candidate_ready}" == 404 ]] || die "legacy migration is allowed only for the expected pre-/ready runtime"
  runtime_check="$(/usr/bin/mktemp -d)"
  if ! ${DOCKER_BIN} inspect "${candidate_id}" >"${runtime_check}/inspect.json" \
    || ! runtime_state plan "${runtime_check}/inspect.json" "${runtime_check}/plan.json" >/dev/null \
    || ! runtime_state validate "${runtime_check}/plan.json" >/dev/null; then
    /usr/bin/rm -rf -- "${runtime_check}"
    die "legacy prior runtime validation failed"
  fi
  /usr/bin/rm -rf -- "${runtime_check}"
  printf 'direct:%s\n' "${candidate_id}"
}

