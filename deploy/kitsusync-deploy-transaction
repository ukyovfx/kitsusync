restore_persistent_state() {
  backup_is_complete "${backup_dir}" || return 1
  /usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/python3 "${RESTORE_STATE}" "${backup_dir}" "${RUNTIME_ROOT}" || return 1
}

transaction_phase=preflight
probe_id=
container_name="$(${DOCKER_BIN} inspect --format '{{.Name}}' "${container_id}")"; container_name="${container_name#/}"
rollback() {
  log "rollback started previous_image_id=${previous_image_id}"
  /usr/bin/sha256sum -c "${backup_dir}/compose.sha256" >/dev/null 2>&1 || return 1
  /usr/bin/sha256sum -c "${backup_dir}/env.sha256" >/dev/null 2>&1 || return 1
  /usr/bin/sha256sum -c "${backup_dir}/runtime-state.sha256" >/dev/null 2>&1 || return 1
  backup_is_complete "${backup_dir}" || return 1
  runtime_state validate "${backup_dir}/runtime/plan.json" || return 1
  local active_id active_status
  active_id="$(${DOCKER_BIN} ps -aq --no-trunc --filter "label=com.docker.compose.project=${PROJECT_NAME}" --filter "label=com.docker.compose.service=${SERVICE}")" || return 1
  if [[ -n "${active_id}" ]]; then
    [[ "${active_id}" =~ ^[0-9a-f]{64}$ ]] || return 1
    ${DOCKER_BIN} stop "${active_id}" >/dev/null 2>&1 || return 1
    active_status="$(${DOCKER_BIN} inspect --format '{{.State.Running}}' "${active_id}")" || return 1
    [[ "${active_status}" == false ]] || return 1
    # Preserve protected metadata, then remove only this stopped container (no
    # force/no volume deletion). Retaining its Compose labels would break retry.
    ${DOCKER_BIN} inspect "${active_id}" >"${backup_dir}/failed-container-inspect.json" || return 1
    printf '%s\n' "${active_id}" >"${backup_dir}/failed-container-id" || return 1
    ${DOCKER_BIN} rm "${active_id}" >/dev/null || return 1
  fi
  # Data must never be restored while a writer is running. All operations here
  # are checked explicitly: Bash disables errexit inside an `if rollback` call.
  restore_persistent_state || return 1
  rollback_id="$(runtime_state create "${backup_dir}/runtime/plan.json")" || return 1
  [[ "${rollback_id}" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "${rollback_id}" >"${backup_dir}/restored-container" || return 1
  ${DOCKER_BIN} inspect "${rollback_id}" >"${backup_dir}/restored-inspect.json" || return 1
  runtime_state compare "${backup_dir}/runtime/plan.json" "${backup_dir}/restored-inspect.json" || return 1
  ${DOCKER_BIN} start "${rollback_id}" >/dev/null || return 1
  if ! compare_runtime_state "${rollback_id}" "${backup_dir}/runtime" "${previous_image_id}" "${previous_revision}" "${previous_source_id}" "${previous_version}" \
    || ! ${DOCKER_BIN} inspect "${rollback_id}" >"${backup_dir}/restored-inspect.json" \
    || ! runtime_state compare "${backup_dir}/runtime/plan.json" "${backup_dir}/restored-inspect.json"; then
    ${DOCKER_BIN} stop "${rollback_id}" >/dev/null 2>&1 || return 1
    [[ "$(${DOCKER_BIN} inspect --format '{{.State.Running}}' "${rollback_id}")" == false ]] || return 1
    return 1
  fi
  if [[ "${prior_validation}" == legacy ]]; then validate_legacy_runtime "${rollback_id}" || return 1; else validate_runtime "${rollback_id}" "$(restored_validation_mode "${prior_validation}")" "${previous_revision}" "${previous_source_id}" "${previous_version}" || return 1; fi
  printf 'rollback=verified\n'
}

finish_transaction() {
  local result=$? recovery_result=0
  trap - EXIT INT TERM
  set +e
  if [[ -n "${probe_id}" ]]; then ${DOCKER_BIN} rm "${probe_id}" >/dev/null 2>&1; fi
  case "${transaction_phase}" in
    quiescing|quiesced)
      ${DOCKER_BIN} start "${container_id}" >/dev/null 2>&1 || recovery_result=1
      if [[ "${recovery_result}" == 0 ]]; then
        if [[ "${prior_validation}" == legacy ]]; then validate_legacy_runtime "${container_id}" || recovery_result=1
        else validate_runtime "${container_id}" "$(restored_validation_mode "${prior_validation}")" "${previous_revision}" "${previous_source_id}" "${previous_version}" || recovery_result=1; fi
      fi ;;
    replacing) rollback || recovery_result=1 ;;
  esac
  if [[ "${recovery_result}" != 0 ]]; then
    printf 'ERROR: automatic recovery incomplete; protected backup=%s; manual recovery required\n' "${backup_dir}" >&2
    result=1
  fi
  /usr/bin/rm -rf "${run_dir}"
  exit "${result}"
}
trap finish_transaction EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Prove that the same daemon accepts the captured reconstruction plan before
# stopping the prior runtime. This stopped probe never binds ports or runs code.
probe_id="$(runtime_state create "${backup_dir}/runtime/plan.json" "${container_name}-restore-probe-$$")"
[[ "${probe_id}" =~ ^[0-9a-f]{64}$ ]] || die "rollback reconstruction probe failed"
${DOCKER_BIN} inspect "${probe_id}" >"${backup_dir}/probe-inspect.json"
runtime_state compare "${backup_dir}/runtime/plan.json" "${backup_dir}/probe-inspect.json" "${container_name}-restore-probe-$$"
${DOCKER_BIN} rm "${probe_id}" >/dev/null
probe_id=
rollback_image_ref="kitsusync:rollback-$(basename "${backup_dir}")"
${DOCKER_BIN} tag "${previous_image_id}" "${rollback_image_ref}" || die "prior image identity could not be preserved"
printf '%s\n' "${rollback_image_ref}" >"${backup_dir}/rollback-image-ref"

transaction_phase=quiescing
${DOCKER_BIN} stop "${container_id}" >/dev/null || die "prior container could not be quiesced after backup"
[[ "$(${DOCKER_BIN} inspect --format '{{.State.Running}}' "${container_id}")" == false ]] || die "prior container is not quiescent"
transaction_phase=quiesced
quiesced_db="${backup_dir}/sqlite.quiesced.db"
sqlite_backup "${RUNTIME_ROOT}/data/sqlite.db" "${quiesced_db}" >/dev/null || die "quiesced SQLite backup failed"
/usr/bin/mv -f "${quiesced_db}" "${backup_dir}/sqlite.db"
/usr/bin/rm -f "${backup_dir}/runtime-secret.key" "${backup_dir}/runtime-secret.absent"
if [[ -f "${RUNTIME_ROOT}/data/runtime-secret.key" && ! -L "${RUNTIME_ROOT}/data/runtime-secret.key" ]]; then /usr/bin/install -o root -g root -m 0600 "${RUNTIME_ROOT}/data/runtime-secret.key" "${backup_dir}/runtime-secret.key"; else : >"${backup_dir}/runtime-secret.absent"; fi
write_persistent_manifest
restart_prior_and_die() { die "$1"; }
/usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/python3 "${RESTORE_STATE}" verify "${backup_dir}"
if [[ "${legacy_direct_fallback}" == true ]]; then
  # Compose cannot replace a recovered container that lacks its config-hash.
  # The complete backup and reconstruction probe above make this removal
  # recoverable; mark the transaction replacing before removing the name.
  transaction_phase=replacing
  ${DOCKER_BIN} rm "${container_id}" >/dev/null || die "recovered legacy container could not be removed after backup"
fi
if ! ${DOCKER_BIN} load -i "${IMAGE_ARCHIVE}" >/dev/null; then restart_prior_and_die "approved image load failed"; fi
loaded_image_id="$(${DOCKER_BIN} image inspect --format '{{.Id}}' "${image}")"; archive_image_id_allows "${loaded_image_id}" "${approved_config_digest}" "${approved_manifest_digest}" || restart_prior_and_die "loaded image ID is not an approved archive content identity"
loaded_content_digest="$(${DOCKER_BIN} image inspect --format '{{json .}}' "${image}" | /usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/python3 "${IMAGE_IDENTITY}" inspect | /usr/bin/sed -n 's/^image_content_digest=//p')" || restart_prior_and_die "loaded image content identity cannot be verified"
[[ "${loaded_content_digest}" == "${approved_content_digest}" ]] || restart_prior_and_die "loaded image content identity does not match approved provenance"
[[ "$(${DOCKER_BIN} image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "${image}")" == "${source_commit}" ]] || restart_prior_and_die "image revision label mismatch"; [[ "$(${DOCKER_BIN} image inspect --format '{{index .Config.Labels "org.opencontainers.image.source-id"}}' "${image}")" == "${source_id}" ]] || restart_prior_and_die "image source label mismatch"; [[ "$(${DOCKER_BIN} image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "${image}")" == "${version}" ]] || restart_prior_and_die "image version label mismatch"
transaction_phase=replacing
if ! compose_override up -d --no-deps --force-recreate "${SERVICE}" >/dev/null; then die "deployment failed; automatic recovery follows"; fi
new_id="$(compose_override ps -q "${SERVICE}")"
if [[ -z "${new_id}" ]] || ! validate_runtime "${new_id}" "${deployment_mode}" "${source_commit}" "${source_id}" "${version}"; then die "deployment validation failed; automatic recovery follows"; fi
post_deploy_ids="$(${DOCKER_BIN} ps -aq --no-trunc --filter "label=com.docker.compose.project=${PROJECT_NAME}" --filter "label=com.docker.compose.service=${SERVICE}")"
[[ "${post_deploy_ids}" == "${new_id}" ]] || die "deployment did not leave exactly one expected KitsuSync service container"
[[ "$(${DOCKER_BIN} inspect --format '{{.Name}}' "${new_id}")" == "${EXPECTED_CONTAINER_NAME}" ]] || die "deployed KitsuSync container name mismatch"
[[ "$(${DOCKER_BIN} inspect --format '{{.Image}}' "${new_id}")" == "${loaded_image_id}" ]] || die "runtime immutable image mismatch"
[[ "$(${DOCKER_BIN} inspect --format '{{.Config.User}}' "${new_id}")" == 10001:10001 ]] || die "runtime user mismatch"
if [[ "${deployment_policy}" == preview ]]; then
  preview_system_status_dom="$(${DOCKER_BIN} exec -e KITSUSYNC_DEPLOY_POLICY=preview "${new_id}" /app/kitsu-discord --preview-system-status-dom)" || die "preview System Status DOM could not be rendered from candidate container"
  [[ "${preview_system_status_dom}" == *telemetry-line* ]] || die "preview System Status DOM contract mismatch: missing telemetry-line"
  for obsolete in telemetry-bar pipeline-health-details data-open-pipeline-details '観測診断を確認'; do
    [[ "${preview_system_status_dom}" != *"${obsolete}"* ]] || die "preview System Status DOM contract mismatch: obsolete marker present"
  done
  log "preview System Status DOM contract passed"
fi
transaction_phase=validated
if [[ "${deployment_mode}" == legacy-migration ]]; then
  mode_tmp="$(/usr/bin/mktemp)"; printf 'normal\n' >"${mode_tmp}"
  /usr/bin/install -o root -g root -m 0600 "${mode_tmp}" "${CONTROL_DIR}/deployment-mode"
  /usr/bin/rm -f "${mode_tmp}" "${LEGACY_IMAGE_FILE}"
fi
transaction_phase=validated
log "deployment completed policy=${deployment_policy} image_id=${loaded_image_id} image_content_digest=${approved_content_digest} container=${new_id}"
if [[ "${deployment_policy}" == preview ]]; then
  printf 'PREVIEW / NON-RELEASE KitsuSync deployment completed: source_commit=%s version=%s image_id=%s image_content_digest=%s container=%s backup=%s\n' "${source_commit}" "${version}" "${loaded_image_id}" "${approved_content_digest}" "${new_id}" "${backup_dir}"
else
  printf 'KitsuSync deployment completed: version=%s image_id=%s image_content_digest=%s container=%s backup=%s\n' "${version}" "${loaded_image_id}" "${approved_content_digest}" "${new_id}" "${backup_dir}"
fi
