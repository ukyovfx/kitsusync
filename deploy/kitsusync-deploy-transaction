write_persistent_manifest
/usr/bin/find "${backup_dir}/runtime" -type f -exec /usr/bin/sha256sum {} + >"${backup_dir}/runtime-state.sha256"
/usr/bin/sha256sum "${override}" "${backup_dir}/target-compose.json" "${backup_dir}/previous-image-id" "${backup_dir}/previous-revision" "${backup_dir}/previous-source-id" "${backup_dir}/previous-version" "${backup_dir}/prior-validation" >>"${backup_dir}/runtime-state.sha256"
