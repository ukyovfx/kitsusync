#!/usr/bin/python3
"""Read-only KitsuSync deployment evidence collector.

Production invocation takes no arguments and uses only the fixed paths below.
It prints sanitized evidence matching the vfxstudio-server evaluator's v1
section names; unavailable proof is omitted so the evaluator returns BLOCKED.
"""
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import sqlite3
import stat
import subprocess
import sys
import tarfile
from contextlib import closing
import urllib.error
import urllib.request


class EvidenceError(Exception):
    pass


class Paths:
    """Fixed production locations; for_fixture exists only for unit tests."""

    def __init__(self, runtime_data: Path, backup_root: Path, state_root: Path,
                 control_root: Path, release_stage: Path, docker_root: Path):
        self.runtime_data = runtime_data
        self.backup_root = backup_root
        self.state_root = state_root
        self.control_root = control_root
        self.release_stage = release_stage
        self.docker_root = docker_root

    @classmethod
    def production(cls):
        return cls(Path("/home/ukyo_vfx/kitsusync/data"),
                   Path("/var/backups/kitsusync-deploy"),
                   Path("/var/lib/kitsusync-deploy"),
                   Path("/etc/kitsusync-deploy"),
                   Path("/root/kitsusync-release-stage"),
                   Path("/var/lib/docker"))

    @classmethod
    def for_fixture(cls, root: Path):
        return cls(root / "runtime/data", root / "backups", root / "state",
                   root / "control", root / "release-stage", root / "docker")


