    "target-provenance", "production-compose.yml", "compose.sha256", "env.sha256",
    "target.override.yml", "target-compose.json", "runtime-state.sha256",
    "backup-complete", "persistent-state.sha256", "rollback-image-ref",
}
RUNTIME_HASHED_ROOT_FILES = {
    "target.override.yml", "target-compose.json", "previous-image-id",
    "previous-revision", "previous-source-id", "previous-version", "prior-validation",
}
PROVENANCE_DIGESTS = {
    "image_archive_sha256": "kitsusync-image.tar",
    "compose_sha256": "docker-compose.yml",
    "deployment_tool_sha256": "kitsusync-deploy",
    "inspection_tool_sha256": "kitsusync-inspect",
    "sqlite_backup_tool_sha256": "kitsusync-sqlite-backup",
    "bootstrap_tool_sha256": "kitsusync-bootstrap",
    "image_identity_tool_sha256": "kitsusync-image-identity",
    "runtime_state_tool_sha256": "kitsusync-runtime-state",
    "restore_state_tool_sha256": "kitsusync-restore-state",
    "preflight_collector_tool_sha256": "kitsusync-preflight-collect",
}
STAGED_FILES = set(PROVENANCE_DIGESTS.values()) | {"deployment-mode", "provenance.txt"}
INSTALLED = {
    "deployment_tool_sha256": Path("/usr/local/sbin/kitsusync-deploy"),
    "inspection_tool_sha256": Path("/usr/local/sbin/kitsusync-inspect"),
