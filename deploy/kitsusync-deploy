#!/bin/bash
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
for inherited_name in $(compgen -e); do
  case "${inherited_name}" in DOCKER_*|COMPOSE_*) printf 'ERROR: inherited Docker/Compose control variables are not accepted\n' >&2; exit 1 ;; esac
done

release_identity_allows() {
  local version="$1" kind="$2" source="$3" source_id="$4" release_commit="$5" release_tag="$6" image="$7" image_id="$8"
  [[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "${kind}" == release && "${source}" =~ ^[0-9a-f]{40}$ \
    && "${source_id}" == "${source}" && "${release_commit}" == "${source}" && "${release_tag}" == "v${version}" \
    && "${image}" == "kitsusync:v${version}" && "${image_id}" =~ ^sha256:[0-9a-f]{64}$ ]]
}

if [[ "${KITSUSYNC_DEPLOY_TEST_MODE:-}" == release-identity ]]; then
  [[ "${EUID}" -ne 0 ]] || exit 1
  shift 0
  release_identity_allows "$@"
  exit $?
fi
if [[ -n "${KITSUSYNC_DEPLOY_TEST_MODE:-}" ]]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  exec /usr/bin/env bash "${script_dir}/kitsusync-deploy-transaction" "$@"
fi
[[ "$#" -eq 0 ]] || { printf 'ERROR: arguments are not accepted\n' >&2; exit 1; }
[[ "${EUID}" -eq 0 ]] || { printf 'ERROR: root execution required\n' >&2; exit 1; }
[[ -d /etc/kitsusync-deploy && ! -L /etc/kitsusync-deploy && "$(/usr/bin/stat -c '%u:%g:%a' /etc/kitsusync-deploy)" == 0:0:700 ]] || { printf 'ERROR: trusted deployment directory is unsafe\n' >&2; exit 1; }
provenance=/etc/kitsusync-deploy/provenance
[[ -f "${provenance}" && ! -L "${provenance}" && "$(/usr/bin/stat -c '%u:%g:%a' "${provenance}")" == 0:0:600 ]] || { printf 'ERROR: trusted release provenance is unsafe\n' >&2; exit 1; }
field() { /usr/bin/sed -n "s/^$1=//p" "${provenance}" | /usr/bin/head -n 1 | /usr/bin/tr -d '\r'; }
version="$(field version)" kind="$(field artifact_kind)" source="$(field source_commit)" source_id="$(field source_id)" release_commit="$(field release_commit)" release_tag="$(field release_tag)" image="$(field image_ref)" image_id="$(field build_daemon_image_id)"
release_identity_allows "${version}" "${kind}" "${source}" "${source_id}" "${release_commit}" "${release_tag}" "${image}" "${image_id}" || { printf 'ERROR: release provenance is not deployable\n' >&2; exit 1; }
export KITSUSYNC_DEPLOY_POLICY=release
exec /usr/local/libexec/kitsusync-deploy-transaction
