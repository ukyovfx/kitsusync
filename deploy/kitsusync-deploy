if ! compose_override up -d --no-deps --force-recreate "${SERVICE}" >/dev/null; then die "deployment failed; automatic recovery follows"; fi
new_id="$(compose_override ps -q "${SERVICE}")"
if [[ -z "${new_id}" ]] || ! validate_runtime "${new_id}" "${deployment_mode}" "${source_commit}" "${source_id}" "${version}"; then die "deployment validation failed; automatic recovery follows"; fi
[[ "$(${DOCKER_BIN} inspect --format '{{.Image}}' "${new_id}")" == "${loaded_image_id}" ]] || die "runtime immutable image mismatch"
[[ "$(${DOCKER_BIN} inspect --format '{{.Config.User}}' "${new_id}")" == 10001:10001 ]] || die "runtime user mismatch"
transaction_phase=validated
if [[ "${deployment_mode}" == legacy-migration ]]; then
