# ============================================================
# KitsuSync environment template
# Copy to .env.local for local development or the supported production wrapper.
# Never commit .env.local to git.
#
# LOCAL DEVELOPMENT ONLY
# Setup flow:
#   1. Fill in the REQUIRED section below.
#   2. Start the app locally: docker compose up -d
#   3. Open http://localhost:8090/bot/setup-wizard for Guided Setup.
#      Or open /bot/admin/setup for Manual Setup (status overview).
# END LOCAL DEVELOPMENT ONLY
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────
# All three are checked by the System Check step before setup begins.

# Public Kitsu hostname used by the app and setup UI.
# Include the scheme and trailing slash.
KITSU_HOSTNAME=http://YOUR_KITSU_HOST/

# Discord bot credential used by /bot/setup-wizard and /bot/admin.
# Create a bot at https://discord.com/developers/applications and invite it
# with Manage Channels + Manage Webhooks permissions.
DISCORD_BOT_TOKEN=REPLACE_ME
DISCORD_GUILD_ID=REPLACE_ME

# ── OPTIONAL ────────────────────────────────────────────────
# These can be set after your first successful test notification.

# Runtime Kitsu credential for the polling loop.
# If left blank at first boot, enter credentials in Guided Setup (Step 1).
KITSU_RUNTIME_EMAIL=
KITSU_RUNTIME_PASSWORD=

# Catch-all Discord webhook for notifications not matched to a project channel.
DISCORD_WEBHOOK_URL=

# LOCAL DEVELOPMENT ONLY
# FileBrowser debug profile credentials.
# Used only when you explicitly run:
#   docker compose --profile debug up -d editor
# Generate a strong random password before use:
#   openssl rand -base64 20
# Then set FB_USERNAME and FB_PASSWORD in your protected .env.local.
# Do NOT leave FB_PASSWORD blank — FileBrowser may start without auth if unset.
FB_USERNAME=admin
# FB_PASSWORD=  ← uncomment and set a generated value before starting
# END LOCAL DEVELOPMENT ONLY
